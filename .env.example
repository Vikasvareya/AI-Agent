# Copy this file to .env for local use and set the tokens through an approved
# secret manager or local-only environment. Never commit real token values.
#
# Generate unique local tokens with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_AGENT_REQUIRE_AUTH=true
AI_AGENT_ADMIN_TOKEN=
AI_AGENT_USER_TOKEN=

# Keep both services loopback-only for local development.
AI_AGENT_API_HOST=127.0.0.1
AI_AGENT_API_PORT=8081
AI_AGENT_HOST=127.0.0.1
AI_AGENT_PORT=8080
AI_AGENT_COOKIE_SECURE=false
# The project coding agent is admin-only and disabled until a workspace is set.
# Example: AI_AGENT_CODING_WORKSPACE=C:\path\to\project
# Coding audit events are pruned after 365 days; 0 retains indefinitely.
# Values above 36500 days are rejected.
AI_AGENT_CODING_AUDIT_RETENTION_DAYS=365
# General privileged-action audit events use the same retention behavior.
# 0 retains indefinitely; values above 36500 days are rejected.
AI_AGENT_AUDIT_RETENTION_DAYS=365
# Comma-separated browser origins allowed for cross-origin API requests.
# For local Vite development, allow its exact origin, e.g.
# AI_AGENT_ALLOWED_ORIGINS=http://127.0.0.1:5174
# Same-origin requests are always allowed; leave blank to disable cross-origin access.
AI_AGENT_ALLOWED_ORIGINS=
# Retain expired or revoked credential metadata for 30 days.
AI_AGENT_CREDENTIAL_RETENTION_DAYS=30
# Remove distributed rate-limit hits older than 24 hours.
AI_AGENT_RATE_LIMIT_HIT_RETENTION_SECONDS=86400

# Select "ollama" (default) or "openai_compatible".
AI_AGENT_PROVIDER=ollama
# Ollama settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60
# OpenAI-compatible Chat Completions API settings. Keep the key server-side.
# Remote endpoints with an API key must use HTTPS. HTTP is allowed for localhost.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_TIMEOUT=60

# Unified web research providers.
SEARCH_PROVIDER=auto
SEARCH_FALLBACK_ENABLED=true
SEARCH_MAX_RESULTS=10
SEARCH_REQUEST_TIMEOUT=20
AI_AGENT_BRAVE_SEARCH_API_KEY=
SEARXNG_ENABLED=false
SEARXNG_BASE_URL=http://127.0.0.1:8888
SEARXNG_TIMEOUT=15
SEARXNG_DEFAULT_CATEGORIES=general
SEARXNG_SECRET=
