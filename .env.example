# Copy this file to .env for local use and set the tokens through an approved
# secret manager or local-only environment. Never commit real token values.
#
# Generate unique local tokens with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_AGENT_REQUIRE_AUTH=true
AI_AGENT_ADMIN_TOKEN=
AI_AGENT_USER_TOKEN=

# Keep both services loopback-only for local development.
AI_AGENT_API_HOST=127.0.0.1
AI_AGENT_API_PORT=8081
AI_AGENT_HOST=127.0.0.1
AI_AGENT_PORT=8080
AI_AGENT_COOKIE_SECURE=false
